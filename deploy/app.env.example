# Copy to the private secrets directory as app.env. No real secrets in Git.
API_TOKEN=replace-with-a-long-random-token
APP_BASE_URL=http://localhost:8000
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Verify current provider availability/pricing before live calls.
MODEL_INPUT_COST_PER_MTOK=0
MODEL_OUTPUT_COST_PER_MTOK=0
MODEL_SPEND_STOP_USD=0.01
PIPELINE_MAX_MODEL_CALLS=40
AGENT_MAX_MODEL_CALLS=12
AGENT_TIMEOUT_SECONDS=120
AGENT_TRANSIENT_RETRIES=1
AGENT_RETRY_BACKOFF_SECONDS=5
RANKING_MODE=deterministic
AGENT_WORKFLOW_ENABLED=false
CV_REVIEW_ENABLED=true
DISCOVERY_SOURCE_TIMEOUT_SECONDS=180
ENABLE_SCHEDULER=false
PIPELINE_TIMEZONE=America/Toronto
PIPELINE_HOUR=8
PIPELINE_MINUTE=0
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
DIGEST_RECIPIENT=
