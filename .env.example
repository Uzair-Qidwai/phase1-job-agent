# ── Anthropic ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: set these for the model/pricing you actually use; 0 disables dollar estimates.
ANTHROPIC_INPUT_COST_PER_MTOK=0
ANTHROPIC_OUTPUT_COST_PER_MTOK=0

# ── PostgreSQL ─────────────────────────────
POSTGRES_URL=postgresql://user:pass@localhost:5432/phase1_jobs

# ── Gmail OAuth2 ───────────────────────────
# Follow: https://developers.google.com/gmail/api/quickstart/python
# Scopes needed: gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com
DIGEST_RECIPIENT=you@gmail.com

# ── Application / scheduler ─────────────────
APP_BASE_URL=http://localhost:8000
PIPELINE_TIMEZONE=America/Toronto
PIPELINE_HOUR=8
PIPELINE_MINUTE=0
SHORTLIST_THRESHOLD=0.65
API_TOKEN=replace-with-a-long-random-token

# Ranking promotion gate: deterministic remains the safe default.
RANKING_MODE=deterministic
RANKING_MODEL=claude-sonnet-4-5
SOURCE_ZERO_ALERT_RUNS=3
