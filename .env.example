# ── Anthropic ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: set these for the model/pricing you actually use; 0 disables dollar estimates.
ANTHROPIC_INPUT_COST_PER_MTOK=0
ANTHROPIC_OUTPUT_COST_PER_MTOK=0

# ── PostgreSQL ─────────────────────────────
POSTGRES_URL=postgresql://user:pass@localhost:5432/phase1_jobs

# ── Gmail OAuth2 ───────────────────────────
# Follow: https://developers.google.com/gmail/api/quickstart/python
# Scopes needed: gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com
DIGEST_RECIPIENT=you@gmail.com

# ── Application / scheduler ─────────────────
APP_BASE_URL=http://localhost:8000
PIPELINE_TIMEZONE=America/Toronto
PIPELINE_HOUR=8
PIPELINE_MINUTE=0
SHORTLIST_THRESHOLD=0.65
API_TOKEN=replace-with-a-long-random-token

# Ranking promotion gate: deterministic remains the safe default.
RANKING_MODE=deterministic
RANKING_MODEL=claude-sonnet-4-5
SOURCE_ZERO_ALERT_RUNS=3

# Provider-independent model runtime. Anthropic preserves the existing baseline.
# OpenAI/Gemini require MODEL_NAME or explicit per-role AGENT_MODELS entries.
MODEL_PROVIDER=anthropic
# MODEL_NAME=your-explicit-model-id
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional prices for the exact configured model; omit to report unknown cost.
# MODEL_INPUT_COST_PER_MTOK=
# MODEL_OUTPUT_COST_PER_MTOK=
# Per-role overrides require provider and unprefixed model name; prices are optional.
# AGENT_MODELS={"writer":{"provider":"openai","model":"your-model-id","max_output_tokens":4096}}
AGENT_WORKFLOW_ENABLED=false
AGENT_MAX_TURNS=6
AGENT_MAX_MODEL_CALLS=12
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_REVISIONS=1

# Whole-pipeline request cap (includes tool loops, revisions and retries).
PIPELINE_MAX_MODEL_CALLS=100
# Optional stop threshold; requires all selected model prices. May overshoot by
# one in-flight response; use provider-side billing limits for a hard money cap.
# Unknown usage under this guard stops subsequent model requests.
# MODEL_SPEND_STOP_USD=1.00
AGENT_MAX_INPUT_BYTES=200000
AGENT_TRANSIENT_RETRIES=1
AGENT_RETRY_BACKOFF_SECONDS=1

# Enable before exposure beyond a trusted private interface; all GETs then need Bearer auth.
API_REQUIRE_READ_AUTH=false

# Optional private CV evidence file; defaults to data/master_cv.md.
# Keep personal evidence outside tracked files (for example .local/master_cv.md).
# MASTER_CV_PATH=/absolute/path/to/private/master_cv.md
